# Spotify Client Credentials (server-to-server only — no redirect URI needed,
# that's only required for user-login/Authorization Code flows, which this
# backend does not use).
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

DATABASE_URL=sqlite:///./songfinder.db

# Rhythm matching thresholds — placeholder starting values, expect to tune
# these against real usage data.
MATCH_CONFIDENCE_THRESHOLD=70
MATCH_MARGIN_THRESHOLD=15
DTW_ALPHA=1.5
DTW_BAND_FRACTION=0.2
DTW_COST_CAP=4.0
MAX_CANDIDATES=8

# Tap validation
MIN_TAPS_FOR_QUERY=5
MIN_TAPS_FOR_TRAINING=4
MAX_TAP_COUNT=100
MAX_TAP_SPAN_MS=30000
MIN_IOI_MS=40

# Tempo bucketing (BPM), derived from crowdsourced samples, not Spotify
TEMPO_SLOW_MAX_BPM=90
TEMPO_FAST_MIN_BPM=130

# Audio fingerprint matching — recalibrated against real query logs, see
# app/config.py for why these are lower than they used to be.
AUDIO_MATCH_MIN_HASHES=8
AUDIO_NOISE_FLOOR_HASHES=4
AUDIO_MATCH_MARGIN_RATIO=1.6
AUDIO_MAX_UPLOAD_BYTES=15000000
AUDIO_MIN_CLIP_SECONDS=2.0

# Experimental: auto-derive rhythm samples from taught audio (quarantined as
# source='auto'; the distance penalty keeps them from outranking human taps)
AUTO_RHYTHM_ENABLED=true
AUTO_RHYTHM_DISTANCE_PENALTY=0.35

# Self-improving corpus: a confident /query result (rhythm or audio) is
# auto-stored as a new training sample, no /confirm needed. Rhythm samples
# are cheap and uncapped; audio fingerprints are capped per song (each clip
# adds ~150-200 rows to a multi-million-row table).
AUTO_CONFIDENT_AUDIO_SAMPLE_CAP=5

# Vocal isolation (Demucs) before onset detection — real accuracy win, but
# genuinely slow on CPU. Requires torch/torchaudio/demucs (pip install).
# Falls back to raw-mix onset detection automatically if unavailable.
VOCAL_SEPARATION_ENABLED=true

# Hybrid rhythm matching: fuse the learned encoder (a metric-learning model
# trained on human tap data) with DTW, routed by query length. Two-stage:
# the fast model embedding filters the catalog to STAGE1_CANDIDATES songs,
# then DTW runs only on those (keeps queries ~1s at full catalog scale
# instead of ~20s). Requires torch + the checkpoint at RHYTHM_MODEL_PATH;
# falls back to pure DTW automatically if either is missing.
# NOTE: the checkpoint is trained on QBT-Extended (CC BY-NC-SA, non-commercial).
HYBRID_MATCHING_ENABLED=true
RHYTHM_MODEL_PATH=models/rhythm_encoder_v2.pt
HYBRID_SHORT_QUERY_TAPS=15
HYBRID_STAGE1_CANDIDATES=60
HYBRID_RRF_K=60
HYBRID_CONFIDENT_MAX_DISTANCE_FULL=0.10
HYBRID_CONFIDENT_MAX_DISTANCE_SHORT=0.04

CORS_ALLOW_ORIGINS=*
