# Base URL of the locally running backend (see backend/README.md).
#
# - Physical device via Expo Go: use your dev machine's LAN IP, e.g.
#   EXPO_PUBLIC_API_URL=http://192.168.1.23:8000
# - Android emulator: EXPO_PUBLIC_API_URL=http://10.0.2.2:8000
# - iOS Simulator: EXPO_PUBLIC_API_URL=http://localhost:8000
#
# After changing this, restart with `npx expo start -c` so the new value is
# picked up (Expo inlines EXPO_PUBLIC_* vars at bundle time).
EXPO_PUBLIC_API_URL=http://localhost:8000
